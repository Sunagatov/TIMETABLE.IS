BACKEND_APP_PASSWORD=memora-dev-password
BACKEND_BOT_INGEST_TOKEN=replace-me-shared-dev-token
BACKEND_ALLOWED_ORIGIN=http://localhost:5173
BACKEND_SESSION_DAYS=30
BACKEND_COOKIE_SECURE=false
MEMORA_OWNER_TELEGRAM_USER_ID=replace-me
MONGODB_URI=mongodb://localhost:27017/memora

# Required for real V1 text AI in local runs
MEMORA_AI_MODE=openai
MEMORA_AI_API_KEY=replace-with-your-openai-compatible-api-key
MEMORA_AI_API_BASE_URL=https://models.inference.ai.azure.com
MEMORA_AI_MODEL=gpt-4o-mini
MEMORA_AI_FALLBACK_TO_DETERMINISTIC=false

# Required for local voice transcription through the remote whisper worker via SSH tunnel
MEMORA_TELEGRAM_BOT_TOKEN=replace-with-your-real-bot-token
MEMORA_TRANSCRIPTION_API_KEY=placeholder
MEMORA_TRANSCRIPTION_API_BASE_URL=http://127.0.0.1:${MEMORA_WHISPER_TUNNEL_PORT:-18083}
MEMORA_TRANSCRIPTION_MODEL=Systran/faster-whisper-base
MEMORA_TRANSCRIPTION_LANGUAGE=
MEMORA_TRANSCRIPTION_TIMEOUT_SECONDS=120
