# Memora source-repo local environment reference.
#
# Runtime/deployment truth belongs in Vault. Use this file only as a safe index
# for local source-module examples.
#
# Module examples:
# - backend/.env.local.example
# - frontend/.env.local.example
# - telegram-bot/.env.local.example
#
# Required values must be configured in the matching module environment:
# - MEMORA_OWNER_TELEGRAM_USER_ID=replace-me
# - OWNER_TELEGRAM_USER_ID=replace-me
# - BACKEND_BOT_INGEST_TOKEN=replace-me-shared-dev-token
# - TELEGRAM_BOT_TOKEN=replace-me
# - MEMORA_TELEGRAM_BOT_TOKEN=replace-me
# - MEMORA_TRANSCRIPTION_API_KEY=replace-me-when-voice-transcription-is-used
